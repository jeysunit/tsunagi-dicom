// BFF のデータベース（docs/spec.md の 2）。画像サーバーの DICOM の値はここに写さず、書き換えもしない。

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// 監査の記録（docs/spec.md の 3.6、第7.0版 17 遵守事項①②）。
// 追記だけ。更新と削除はデータベースの trigger で断る（migration を参照）。
// 各行は前の行の hash を prevHash に持ち、hash は行の中身と prevHash の SHA-256。
model AuditLog {
  // 1 から始まる続き番号。抜けがあれば、行が消されたと分かる
  seq              Int      @id
  // いつ（サーバーの時計。UTC で持つ）
  occurredAt       DateTime
  // 誰が
  actorId          String
  actorRole        String
  authMode         String
  // 何をした（login・logout・search・view_study・open_viewer・modify・delete・import・config_change・role_switch・write）
  action           String
  // success か denied
  outcome          String
  // どの患者と検査に（無い操作は null）
  patientId        String?
  studyInstanceUid String?
  // 接続元（分かるときだけ）
  sourceAddress    String?
  // 補足（JSON の文字列）
  detail           String?
  prevHash         String   @unique
  hash             String   @unique

  @@index([occurredAt])
  @@index([patientId])
  @@index([studyInstanceUid])
}
