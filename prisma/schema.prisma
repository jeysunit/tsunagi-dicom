// BFF のデータベース（docs/spec.md の 2）。画像サーバーの DICOM の値はここに写さず、書き換えもしない。

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// 監査の記録（docs/spec.md の 3.6、第7.0版 17 遵守事項①②）。
// 追記だけ。更新と削除はデータベースの trigger で断る（migration を参照）。
// 各行は前の行の hash を prevHash に持ち、hash は行の中身と prevHash の HMAC-SHA256（鍵は SESSION_SECRET から導く。
// keyId が空の行は、鍵つきにする前の鍵の無い SHA-256。docs/adr/0001-audit-chain-mac.md）。
model AuditLog {
  // 1 から始まる続き番号。抜けがあれば、行が消されたと分かる。値はアプリ（src/lib/audit.ts）が決めて入れる。
  // Prisma は SQLite の Int の @id を `INTEGER PRIMARY KEY AUTOINCREMENT` にする（migration と同じ。
  // `prisma migrate diff --from-config-datasource --to-schema` で差が無いことを確かめた）。番号を省いて足す道は使わない
  seq                     Int      @id
  // いつ（サーバーの時計。UTC で持つ）
  occurredAt              DateTime
  // 誰が
  actorId                 String
  actorRole               String
  authMode                String
  // 何をした（src/lib/audit.ts の AUDIT_ACTIONS。login・logout・search・retrieve・role_change など）
  action                  String
  // success・denied（このアプリが断った）・failed（画像サーバーが失敗を返した）
  outcome                 String
  // どの患者と検査に（無い操作は null）
  patientId               String?
  studyInstanceUid        String?
  // 確かめた接続元。信じるプロキシの設定が無い間は null
  sourceAddress           String?
  // 補足（JSON の文字列）
  detail                  String?
  prevHash                String   @unique
  hash                    String   @unique
  // 要求のヘッダーにあった接続元（X-Forwarded-For など。偽れる値）。hash には値があるときだけ入れる
  sourceAddressUnverified String?
  // hash を計算した鍵の印（src/lib/audit-key.ts）。空の行は、鍵つきにする前の鍵の無い SHA-256 の行
  keyId                   String?

  @@index([occurredAt])
  @@index([patientId])
  @@index([studyInstanceUid])
  // 書き込みの操作の要求の ID を、決めた期間の中の同じ操作の行だけから探すため（src/lib/pacs-ops.ts。段 4）
  @@index([action, occurredAt])
  // 書き込みの操作の、同じ検査の要求（解いていない結果不明の要求）を、期間で切らずに探すため（src/lib/pacs-ops.ts。段 5）
  @@index([action, studyInstanceUid])
}

// アプリの利用者（AUTH_MODE=local。docs/spec.md の 3.6、第7.0版 14 遵守事項①②⑤⑥⑧・14.2）。
// 利用者は消さずに止める（status = disabled）。監査の記録の「誰が」（actorId = username）を後から追えるようにするため。
model User {
  id                 String    @id
  // ログインの名前。作った後は変えない（監査の記録の actorId に使う）
  username           String    @unique
  displayName        String
  // admin・general（src/lib/auth/roles.ts。2026-10-20 に4つから2つにした。migration 20261020100000_two_roles）
  role               String
  // 役割の世代。役割を変えるたびに、同じ文で1つ上げる。再認証の印は、通した時の世代と今の世代が同じときだけ使う
  // （src/lib/auth/local-auth.ts の assertRecentReauth。前の役割で通した印を、格上げの後に使わせない）
  roleVersion        Int       @default(0)
  // active・disabled
  status             String    @default("active")
  // argon2id の PHC の文字列（$argon2id$v=19$m=…,t=…,p=…$salt$hash）。平文には戻せない
  passwordHash       String
  passwordChangedAt  DateTime
  // 管理者が決めたパスワード（作った時）は、次のログインで本人が変える
  mustChangePassword Boolean   @default(false)
  // TOTP の秘密（AES-256-GCM で暗号化。鍵は SESSION_SECRET から HKDF で導く。src/lib/auth/sealed-field.ts）
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  // 最後に受け入れた TOTP の時間の段（30 秒ごと）。同じ段・前の段の使い回しを断る
  totpLastStep       Int?
  // ログインの一時停止（第7.0版 14 遵守事項⑥(6)）
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  // 利用者の棚卸し（第7.0版 14 遵守事項⑧）
  lastLoginAt        DateTime?
  // 認証の世代。パスワードの変更・TOTP の登録・TOTP のやり直しで 1 つ増やす。セッションは作った時の値を持ち、
  // 違えば使わない（src/lib/auth/local-auth.ts の resolveSession。ほかのセッションの削除は後片付け）
  credentialVersion  Int       @default(0)
  createdAt          DateTime
  updatedAt          DateTime

  sessions Session[]
}

// ログインのセッション。cookie には乱数の token を入れ、ここには token の SHA-256 だけを持つ。
model Session {
  // token の SHA-256（16 進）
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // totp（TOTP の入力待ち）・enroll（TOTP の登録待ち）・change_password（パスワードの変更待ち）・active
  stage          String
  // CSRF の対策の token（状態を変える要求の x-csrf-token と比べる）
  csrfToken      String
  createdAt      DateTime
  expiresAt      DateTime
  // 最後の操作（画面のロックの時間を数える元）
  lastActivityAt DateTime
  // 画面のロック（第7.0版 12 遵守事項⑥）。null でなければロックしている
  lockedAt       DateTime?
  // 登録の途中の TOTP の秘密（暗号化）。登録を確かめたら User へ移す
  pendingTotpEnc String?
  // 大事な操作（利用者の管理・削除など）の前の、もう一度の本人の確かめの時刻（src/lib/auth/local-auth.ts の REAUTH_MINUTES）。
  // サーバーの側のこの行だけに持つ（cookie・本文から読まない）。パスワードの変更で消す
  reauthAt       DateTime?
  // 上の確かめで TOTP まで確かめた時刻。利用者の管理（ユーザーの追加・役割・無効・TOTP のやり直しなど）は、TOTP を登録した
  // 利用者にはこちらを求める（削除の再認証はパスワードだけ。docs/spec.md の 3.6。2026-10-20）
  reauthMfaAt    DateTime?
  // 上の確かめを通した時の利用者の役割の世代（User.roleVersion）。違えば、上の2つの時刻は使わない
  reauthRoleVersion Int?
  // 作った時の利用者の認証の世代（User.credentialVersion）。違えば、このセッションは使えない
  credentialVersion Int    @default(0)

  @@index([userId])
  @@index([expiresAt])
}

// 利用者ごとの画面の設定（段 2。docs/spec.md の 2）。いまは地の色（明るい地・暗い地）だけ。
// actorId は監査の記録の「誰が」と同じ値（AUTH_MODE=local は利用者名、検証モードは dev）。
model UserPreference {
  actorId   String   @id
  // light・dark
  theme     String
  updatedAt DateTime
}

// 検査ごとに覚えたビューア（段 2。docs/spec.md の 3.2）。変えた人と時刻は監査の記録（study_state。flag は viewer）にも残す。
// 段 2 の検査の状態の印（検像・読影・緊急・ブックマーク）の表は、段 3 で外した（migration 20261020000000_remove_study_state）。
model StudyViewer {
  studyInstanceUid String   @id
  // 検査ごとに覚えたビューア（src/lib/viewers.ts の ID）。null は覚えが無い（モダリティの既定で開く）
  viewer           String?
  // 版。変えるたびに 1 つ上げる。画面は読んだ時の版を添えて変え、違えば 409（古い画面からの上書きを断る）
  version          Int      @default(0)
  updatedBy        String
  updatedAt        DateTime
}

// モダリティごとの既定のビューア（管理の画面で変える。docs/spec.md の 3.2）
model ModalityViewerDefault {
  // CT・MR・CR/DX など（src/lib/modalities.ts の群）
  modality  String   @id
  viewer    String
  updatedBy String
  updatedAt DateTime
}
