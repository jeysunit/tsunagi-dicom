// BFF のデータベース（docs/spec.md の 2）。画像サーバーの DICOM の値はここに写さず、書き換えもしない。

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// 監査の記録（docs/spec.md の 3.6、第7.0版 17 遵守事項①②）。
// 追記だけ。更新と削除はデータベースの trigger で断る（migration を参照）。
// 各行は前の行の hash を prevHash に持ち、hash は行の中身と prevHash の SHA-256。
model AuditLog {
  // 1 から始まる続き番号。抜けがあれば、行が消されたと分かる。値はアプリ（src/lib/audit.ts）が決めて入れる。
  // Prisma は SQLite の Int の @id を `INTEGER PRIMARY KEY AUTOINCREMENT` にする（migration と同じ。
  // `prisma migrate diff --from-config-datasource --to-schema` で差が無いことを確かめた）。番号を省いて足す道は使わない
  seq                     Int      @id
  // いつ（サーバーの時計。UTC で持つ）
  occurredAt              DateTime
  // 誰が
  actorId                 String
  actorRole               String
  authMode                String
  // 何をした（src/lib/audit.ts の AUDIT_ACTIONS。login・logout・search・retrieve・role_change など）
  action                  String
  // success・denied（このアプリが断った）・failed（画像サーバーが失敗を返した）
  outcome                 String
  // どの患者と検査に（無い操作は null）
  patientId               String?
  studyInstanceUid        String?
  // 確かめた接続元。信じるプロキシの設定が無い間は null
  sourceAddress           String?
  // 補足（JSON の文字列）
  detail                  String?
  prevHash                String   @unique
  hash                    String   @unique
  // 要求のヘッダーにあった接続元（X-Forwarded-For など。偽れる値）。hash には値があるときだけ入れる
  sourceAddressUnverified String?

  @@index([occurredAt])
  @@index([patientId])
  @@index([studyInstanceUid])
}

// アプリの利用者（AUTH_MODE=local。docs/spec.md の 3.6、第7.0版 14 遵守事項①②⑤⑥⑧・14.2）。
// 利用者は消さずに止める（status = disabled）。監査の記録の「誰が」（actorId = username）を後から追えるようにするため。
model User {
  id                 String    @id
  // ログインの名前。作った後は変えない（監査の記録の actorId に使う）
  username           String    @unique
  displayName        String
  // admin・doctor・technologist・viewer（src/lib/auth/roles.ts）
  role               String
  // active・disabled
  status             String    @default("active")
  // argon2id の PHC の文字列（$argon2id$v=19$m=…,t=…,p=…$salt$hash）。平文には戻せない
  passwordHash       String
  passwordChangedAt  DateTime
  // 管理者が決めたパスワード（作った時）は、次のログインで本人が変える
  mustChangePassword Boolean   @default(false)
  // TOTP の秘密（AES-256-GCM で暗号化。鍵は SESSION_SECRET から HKDF で導く。src/lib/auth/sealed-field.ts）
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  // 最後に受け入れた TOTP の時間の段（30 秒ごと）。同じ段・前の段の使い回しを断る
  totpLastStep       Int?
  // ログインの一時停止（第7.0版 14 遵守事項⑥(6)）
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  // 利用者の棚卸し（第7.0版 14 遵守事項⑧）
  lastLoginAt        DateTime?
  // 認証の世代。パスワードの変更・TOTP の登録・TOTP のやり直しで 1 つ増やす。セッションは作った時の値を持ち、
  // 違えば使わない（src/lib/auth/local-auth.ts の resolveSession。ほかのセッションの削除は後片付け）
  credentialVersion  Int       @default(0)
  createdAt          DateTime
  updatedAt          DateTime

  sessions Session[]
}

// ログインのセッション。cookie には乱数の token を入れ、ここには token の SHA-256 だけを持つ。
model Session {
  // token の SHA-256（16 進）
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // totp（TOTP の入力待ち）・enroll（TOTP の登録待ち）・change_password（パスワードの変更待ち）・active
  stage          String
  // CSRF の対策の token（状態を変える要求の x-csrf-token と比べる）
  csrfToken      String
  createdAt      DateTime
  expiresAt      DateTime
  // 最後の操作（画面のロックの時間を数える元）
  lastActivityAt DateTime
  // 画面のロック（第7.0版 12 遵守事項⑥）。null でなければロックしている
  lockedAt       DateTime?
  // 登録の途中の TOTP の秘密（暗号化）。登録を確かめたら User へ移す
  pendingTotpEnc String?
  // 大事な操作（利用者の管理）の前の、もう一度の本人の確かめの時刻（src/lib/auth/local-auth.ts の REAUTH_MINUTES）
  reauthAt       DateTime?
  // 作った時の利用者の認証の世代（User.credentialVersion）。違えば、このセッションは使えない
  credentialVersion Int    @default(0)

  @@index([userId])
  @@index([expiresAt])
}
