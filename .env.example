# tsunagi-dicom の設定の例。docs/spec.md の「2.1 設定」と同じ中身。
# 値は例の名前だけ。秘密の値は空のままにし、既定値を置かない。
# 写して .env にし、施設の値を入れる（.env はリポジトリに入れない）。

# ── バックエンド（BFF から見た画像サーバー） ──
# orthanc | dicomweb（DICOMweb だけの汎用。Orthanc 固有の機能は無効）
BACKEND_KIND="orthanc"
BACKEND_DICOMWEB_URL="https://pacs.example.org/dicom-web"
# BACKEND_KIND=orthanc のとき
BACKEND_ORTHANC_URL="https://pacs.example.org"
# 空なら認証なし
BACKEND_USERNAME=""
# 秘密。既定値を置かない。ファイルで渡すときは BACKEND_PASSWORD_FILE
BACKEND_PASSWORD=""
BACKEND_PASSWORD_FILE=""
# 自前の CA（例：施設の CA）。証明書の確かめを切る設定は持たない
BACKEND_CA_FILE=""
# true でモックのバックエンド（tests/fixtures の合成のデータ）を使う。開発・CI 用
BACKEND_MOCK="false"

# ── ビューア（ブラウザから開く URL。別のサーバーでもよい。空なら、そのビューアを出さない） ──
VIEWER_OHIF_URL="https://pacs.example.org/ohif/viewer"
VIEWER_STONE_URL="https://pacs.example.org/stone-webviewer/index.html"
VIEWER_VOLVIEW_URL="https://pacs.example.org/volview/index.html"
# true で Weasis（weasis://）を出す。false なら出さない。Weasis は段 4 の後
VIEWER_WEASIS_ENABLED="false"
# 研究の道具へ渡す URL（コピー用）
PUBLIC_DICOMWEB_URL="https://pacs.example.org/dicom-web"

# ── 認証 ──
# local（アプリの利用者。既定）| oidc（外部の認証。段 4）| dev（開発用。docs/spec.md の 4）
# dev は段 1a〜1b では BACKEND_MOCK=true のときだけ起動する。実の画像サーバーには local を使う
AUTH_MODE="local"
# true：二要素が必須。パスワードは8文字以上。false：13文字以上（第7.0版 14.1.1）
MFA_REQUIRED="true"
# 続けて失敗したら、一定時間ログインできなくする
LOGIN_LOCK_THRESHOLD="5"
LOGIN_LOCK_MINUTES="15"
# ログインを遅らせ始める回数（1 分あたり。利用者名ごと・全体。超えたら断らずに遅らせる）
LOGIN_RATE_LIMIT_PER_MINUTE="10"
LOGIN_RATE_LIMIT_GLOBAL_PER_MINUTE="300"
# パスワードの確かめ（argon2）を同時に回す数と、待ち行列の長さ。超えたら 503 と Retry-After で断る
PASSWORD_HASH_CONCURRENCY="2"
PASSWORD_HASH_QUEUE="32"
# 操作が無いときの画面のロック（0 で無効）
SCREEN_LOCK_MINUTES="15"
# 画面のロックを解くときに TOTP も求めるか（既定 false：パスワードだけ。ログインと再認証の TOTP は、この設定に関わらず求める）
SCREEN_UNLOCK_REQUIRE_TOTP="false"
# セッションの長さ（運用に合わせて変える）：ログインした後の上限（時間・1〜24）、ログインの途中（分・1〜60）、大事な操作の前の再認証が効く時間（分・1〜60）
SESSION_MAX_HOURS="12"
LOGIN_PENDING_MINUTES="10"
REAUTH_MINUTES="5"
# 最初の管理者（AUTH_MODE=local で利用者が1人もいないときだけ使う。パスワードは秘密のファイルで渡す）
INITIAL_ADMIN_USERNAME=""
INITIAL_ADMIN_PASSWORD_FILE=""
# AUTH_MODE=oidc のとき。OIDC_CLIENT_SECRET は秘密。ファイルで渡すときは OIDC_CLIENT_SECRET_FILE（同時には指定しない）
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_CLIENT_SECRET_FILE=""
# AUTH_MODE=dev のときだけ効く。true で書き込みも試す（既定は止める）。
# 書き込みの道は段 4 まで無い（中継は WADO-RS の読み取りだけ）ので、それまでは true にすると起動しない
DEV_ALLOW_WRITE="false"

# ── 画面 ──
# 検査の一覧の自動更新の間隔（秒）。0 で止める。止めないときは 5〜3600。
# 間隔ごとに Orthanc の /changes の最新の番号だけを読み、番号が進んだときだけ一覧を読み直す
STUDY_LIST_REFRESH_SECONDS="30"
# 詳細のパネルでサムネイルを押したときの「主なタグ」に出すタグの番号（空白で区切り、書いた順に出す。100 個まで）。
# 空なら既定の 25 のタグ（画像番号・位置・行数と列数・ウィンドウなど）。例：INSTANCE_TAGS="(0008,0018) (0020,0013) (0028,0010)"
INSTANCE_TAGS=""

# ── データ ──
DATABASE_URL="file:/data/tsunagi.db"
# 秘密。必須。32 バイト以上の乱数。どちらも空なら起動しない。
# ファイルで渡すときは SESSION_SECRET_FILE（compose.yaml の例はこちら）。同時には指定しない（起動しない）
SESSION_SECRET=""
SESSION_SECRET_FILE=""
# 秘密。省ける。前に使っていた SESSION_SECRET を 1 行に 1 つ、古い順（上が古い）に書いたファイル（どの行も 32 バイト以上）。
# 監査の記録のつなぎの鍵は SESSION_SECRET から導くので、SESSION_SECRET を替えた後も、前の鍵で書いた行を
# /api/audit/verify で確かめるためだけに使う（セッションや token には使わない。docs/adr/0001-audit-chain-mac.md）
SESSION_SECRET_PREVIOUS_FILE=""
# 省ける。監査の記録の先頭の控え（最後の行の seq と hash）を追記するファイル（絶対のパス。JSON Lines）。
# データベースとは別の置き場にする（配る compose は別のボリュームの /audit-anchors/audit-anchors.jsonl）。
# /api/audit/verify はこの控えと照らす。空なら照らせないので、記録があれば 409（anchors.status が not-configured）。
# ファイルは、記録も利用者もまだ無い初めての起動のときだけ作る。記録のある一式で始めるとき（前の版から上げたとき）は、
# 空のファイルを置く（docs/security-and-maintenance.md の 5）。
# 控えは、この設定に関わらずコンテナのログ（tsunagi-dicom: audit-anchor …）にも出す
AUDIT_ANCHOR_FILE=""
TZ="Asia/Tokyo"

# 秘密。省ける。HL7 の受け口と BFF の間の token のファイル（32 文字以上）。下の発番元と組で設定する。どちらも空なら受け付けない
HL7_RECEIVER_TOKEN_FILE=""
# 省ける。受ける患者 ID の発番元（HL7 の CX の 4 つめの namespace ID。例 RIS_EMU）
HL7_PATIENT_ID_ISSUER=""
