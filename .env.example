# tsunagi-dicom の設定の例。docs/spec.md の「2.1 設定」と同じ中身。
# 値は例の名前だけ。秘密の値は空のままにし、既定値を置かない。
# 写して .env にし、施設の値を入れる（.env はリポジトリに入れない）。

# ── バックエンド（BFF から見た画像サーバー） ──
# orthanc | dicomweb（DICOMweb だけの汎用。Orthanc 固有の機能は無効）
BACKEND_KIND="orthanc"
BACKEND_DICOMWEB_URL="https://pacs.example.org/dicom-web"
# BACKEND_KIND=orthanc のとき
BACKEND_ORTHANC_URL="https://pacs.example.org"
# 空なら認証なし
BACKEND_USERNAME=""
# 秘密。既定値を置かない。ファイルで渡すときは BACKEND_PASSWORD_FILE
BACKEND_PASSWORD=""
BACKEND_PASSWORD_FILE=""
# 自前の CA（例：施設の CA）。証明書の確かめを切る設定は持たない
BACKEND_CA_FILE=""
# true でモックのバックエンド（tests/fixtures の合成のデータ）を使う。開発・CI 用
BACKEND_MOCK="false"

# ── ビューア（ブラウザから開く URL。別のサーバーでもよい。空なら、そのビューアを出さない） ──
VIEWER_OHIF_URL="https://pacs.example.org/ohif/viewer"
VIEWER_STONE_URL="https://pacs.example.org/stone-webviewer/index.html"
VIEWER_VOLVIEW_URL="https://pacs.example.org/volview/index.html"
# true で Weasis（weasis://）を出す。false なら出さない。Weasis は段 4 の後
VIEWER_WEASIS_ENABLED="false"
# 研究の道具へ渡す URL（コピー用）
PUBLIC_DICOMWEB_URL="https://pacs.example.org/dicom-web"

# ── 認証 ──
# local（アプリの利用者）| oidc（外部の認証。段 4）| dev（開発用。docs/spec.md の 4）
AUTH_MODE="local"
# true：二要素が必須。パスワードは8文字以上。false：13文字以上（第7.0版 14.1.1）
MFA_REQUIRED="true"
# 続けて失敗したら、一定時間ログインできなくする
LOGIN_LOCK_THRESHOLD="5"
LOGIN_LOCK_MINUTES="15"
# 操作が無いときの画面のロック（0 で無効）
SCREEN_LOCK_MINUTES="15"
# AUTH_MODE=oidc のとき。OIDC_CLIENT_SECRET は秘密
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
# AUTH_MODE=dev のときだけ効く。true で書き込みも試す（既定は止める）
DEV_ALLOW_WRITE="false"

# ── データ ──
DATABASE_URL="file:/data/tsunagi.db"
# 秘密。必須。32 バイト以上の乱数。空なら起動しない
SESSION_SECRET=""
TZ="Asia/Tokyo"
